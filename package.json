{
  "name": "agent-floor-ui",
  "version": "0.1.0",
  "description": "A pluggable Three.js workspace for live AI agents",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/albertjayinm/agent-floor-ui.git" },
  "homepage": "https://github.com/albertjayinm/agent-floor-ui#readme",
  "bugs": { "url": "https://github.com/albertjayinm/agent-floor-ui/issues" },
  "type": "module",
  "files": [
    "dist",
    "skills",
    "README.md",
    "src",
    "scripts",
    "tests",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "vite.lib.config.ts",
    "playwright.config.ts"
  ],
  "bin": { "agent-floor-ui": "./scripts/cli.mjs" },
  "engines": { "node": ">=22.18.0" },
  "main": "./dist/agent-floor-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agent-floor-ui.js"
    },
    "./style.css": "./dist/agent-floor-ui.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.lib.config.ts && tsc --emitDeclarationOnly",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "playwright test",
    "relay": "node scripts/cli.mjs relay",
    "media": "node scripts/capture-media.mjs",
    "prepack": "npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": ">=19",
    "react-dom": ">=19",
    "three": "^0.185.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
